__pycache__/
*.py[cod]
.venv/
venv/
env/
build/
dist/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node: deps / build / cache / logs
node_modules/
.next/
out/
.turbo/
.npm/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*~

# Agent trace state (.banyancode/ matches at any depth, e.g. D/.banyancode/); not source
.banyancode/
